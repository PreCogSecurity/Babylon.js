{
    "root": true,
    "env": {
        "node": true,
        "es6": true,
        "mocha": true
    },
    "parserOptions": {
        "ecmaVersion": 2015
    },
    "rules": {
        "semi": ["error", "always"],
        "quotes": ["error", "double", { "avoidEscape": true }],
        "indent": ["error", 4],
        "no-undef": "error",
        "no-unused-vars": ["error", { "args": "none" }],
        "no-var": "off",
        "strict": ["error", "safe"]
    }
}